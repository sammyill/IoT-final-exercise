[{"id":"tab-amqp-dashboard","type":"tab","label":"Dashboard","disabled":false,"info":"Polling InfluxDB ogni 5s — grafico temperature 10 sensori"},{"id":"tab-amqp-alerting","type":"tab","label":"Alerting","disabled":false,"info":"Controllo soglie ogni 30s — email via Mailhog"},{"id":"tab-amqp-chaos","type":"tab","label":"Chaos Events","disabled":false,"info":"Riceve eventi dal Chaos Monkey via HTTP POST /chaos/events"},{"id":"influxdb-cfg-amqp","type":"influxdb","hostname":"influxdb","port":"8086","protocol":"http","database":"iot","name":"InfluxDB AMQP Stack","usetls":false,"tls":"","influxdbVersion":"2.0","url":"http://influxdb_amqp:8086","timeout":"","rejectUnauthorized":true},{"id":"ui-tab-amqp","type":"ui_tab","name":"IoT AMQP","icon":"dashboard","order":1,"disabled":false,"hidden":false},{"id":"ui-group-amqp","type":"ui_group","name":"Temperature Sensori (AMQP)","tab":"ui-tab-amqp","order":1,"disp":true,"width":"12","collapse":false},{"id":"d96b9a6c9b719d24","type":"ui_base","theme":{"name":"theme-light","lightTheme":{"default":"#0094CE","baseColor":"#0094CE","baseFont":"-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif","edited":false},"darkTheme":{"default":"#097479","baseColor":"#097479","baseFont":"-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif","edited":false},"customTheme":{"name":"Untitled Theme 1","default":"#4B7930","baseColor":"#4B7930","baseFont":"-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif"},"themeState":{"base-color":{"default":"#0094CE","value":"#0094CE","edited":false},"page-titlebar-backgroundColor":{"value":"#0094CE","edited":false},"page-backgroundColor":{"value":"#fafafa","edited":false},"page-sidebar-backgroundColor":{"value":"#ffffff","edited":false},"group-textColor":{"value":"#1bbfff","edited":false},"group-borderColor":{"value":"#ffffff","edited":false},"group-backgroundColor":{"value":"#ffffff","edited":false},"widget-textColor":{"value":"#111111","edited":false},"widget-backgroundColor":{"value":"#0094ce","edited":false},"widget-borderColor":{"value":"#ffffff","edited":false},"base-font":{"value":"-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif"}},"angularTheme":{"primary":"indigo","accents":"blue","warn":"red","background":"grey","palette":"light"}},"site":{"name":"Node-RED Dashboard","hideToolbar":"false","allowSwipe":"false","lockMenu":"false","allowTempTheme":"true","dateFormat":"DD/MM/YYYY","sizes":{"sx":48,"sy":48,"gx":6,"gy":6,"cx":6,"cy":6,"px":0,"py":0}}},{"id":"amqp-inject-poll","type":"inject","z":"tab-amqp-dashboard","name":"Ogni 5s","props":[{"p":"payload","v":"","vt":"date"},{"p":"topic","v":"","vt":"str"}],"repeat":"5","crontab":"","once":true,"onceDelay":2,"topic":"","payload":"","payloadType":"date","x":110,"y":80,"wires":[["amqp-influx-in"]]},{"id":"amqp-influx-in","type":"influxdb in","z":"tab-amqp-dashboard","influxdb":"influxdb-cfg-amqp","name":"Query ultimi 5 min","query":"from(bucket:\"iot\") |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"temperatura\" and r._field == \"value\")","rawOutput":false,"precision":"","retentionPolicy":"","org":"its","x":330,"y":80,"wires":[["amqp-fn-format"]]},{"id":"amqp-fn-format","type":"function","z":"tab-amqp-dashboard","name":"Formatta per grafico","func":"var rows = msg.payload;\nif (!Array.isArray(rows) || rows.length === 0) { return null; }\nvar msgs = [];\nfor (var i = 0; i < rows.length; i++) {\n    var row = rows[i];\n    var ts = new Date(row._time).getTime();\n    msgs.push({\n        topic:     row.sensor_id || 'sensor',\n        payload:   parseFloat(row._value),\n        timestamp: ts\n    });\n}\nreturn [msgs];\n","outputs":1,"noerr":0,"x":580,"y":80,"wires":[["amqp-chart"]]},{"id":"amqp-chart","type":"ui_chart","z":"tab-amqp-dashboard","name":"Grafico Temperature","group":"ui-group-amqp","order":1,"width":"12","height":"6","label":"Temperatura (°C) — Stack AMQP","chartType":"line","legend":true,"xformat":"HH:mm:ss","interpolate":"linear","nodata":"In attesa di dati...","dot":false,"ymin":"10","ymax":"40","removeOlder":5,"removeOlderPoints":"","removeOlderUnit":"60","cutout":0,"useOneColor":false,"colors":["#1f77b4","#ff7f0e","#2ca02c","#d62728","#9467bd","#8c564b","#e377c2","#7f7f7f","#bcbd22","#17becf"],"outputs":1,"x":820,"y":80,"wires":[[]]},{"id":"amqp-inject-alert","type":"inject","z":"tab-amqp-alerting","name":"Ogni 30s","repeat":"30","crontab":"","once":true,"onceDelay":5,"topic":"","payload":"","payloadType":"date","x":110,"y":80,"wires":[["amqp-influx-alert"]]},{"id":"amqp-influx-alert","type":"influxdb in","z":"tab-amqp-alerting","influxdb":"influxdb-cfg-amqp","name":"Ultimo valore per sensore","query":"from(bucket:\"iot\") |> range(start: -35s) |> filter(fn: (r) => r._measurement == \"temperatura\" and r._field == \"value\") |> last()","rawOutput":false,"precision":"","retentionPolicy":"","org":"its","x":410,"y":140,"wires":[["amqp-fn-soglie"]]},{"id":"amqp-fn-soglie","type":"function","z":"tab-amqp-alerting","name":"Controlla soglie","func":"var SOGLIA_ALTA = 30;\nvar SOGLIA_BASSA = 16;\nvar rows = msg.payload;\nif (!Array.isArray(rows) || rows.length === 0) return null;\nvar alerts = [];\nfor (var i = 0; i < rows.length; i++) {\n    var r = rows[i];\n    var t = parseFloat(r._value);\n    var sid = r.sensor_id || '?';\n    if (t > SOGLIA_ALTA) alerts.push('⚠ ALTA: ' + sid + ' = ' + t + '°C');\n    else if (t < SOGLIA_BASSA) alerts.push('⚠ BASSA: ' + sid + ' = ' + t + '°C');\n}\nif (alerts.length === 0) return null;\nmsg.topic   = '[IoT AMQP] Alert temperatura';\nmsg.payload = alerts.join('\\n');\nmsg.to      = 'studente@lab.local';\nmsg.from    = 'iot-amqp@lab.local';\nreturn msg;\n","outputs":1,"noerr":0,"x":660,"y":120,"wires":[["amqp-email-alert"]]},{"id":"amqp-email-alert","type":"e-mail","z":"tab-amqp-alerting","server":"mailhog","port":"1025","authtype":"NONE","tls":false,"name":"Mailhog","dname":"Email Alert","x":890,"y":100,"wires":[]},{"id":"amqp-http-in-chaos","type":"http in","z":"tab-amqp-chaos","name":"POST /chaos/events","url":"/chaos/events","method":"post","upload":false,"swaggerDoc":"","x":140,"y":80,"wires":[["amqp-fn-chaos"]]},{"id":"amqp-fn-chaos","type":"function","z":"tab-amqp-chaos","name":"Formatta email chaos","func":"var e = msg.payload;\nvar phase = e.phase || 'UNKNOWN';\nvar tipo  = e.event_type || '?';\nvar cont  = e.container || '?';\nvar dur   = e.duration || 0;\nvar cnt   = e.event_count || 0;\nvar soggetto, corpo;\nif (phase === 'DROP') {\n    soggetto = '[CHAOS #' + cnt + '] DROP — ' + tipo + ' (' + cont + ')';\n    corpo = 'EVENTO CHAOS #' + cnt + '\\n══════════════════════════════\\n';\n    corpo += 'Tipo: ' + tipo + ' | Container: ' + cont + ' | Durata: ' + dur + 's\\n\\n';\n    if (tipo === 'sensor_single' || tipo === 'sensor_multi') {\n        corpo += 'Cosa osservare:\\n• Il sensore perde la connessione AMQP\\n• Bufferizza i dati in RAM (deque locale)\\n• RabbitMQ NON riceve messaggi da quel sensore\\n';\n    } else if (tipo === 'rabbitmq') {\n        corpo += 'Cosa osservare:\\n• TUTTI i sensori perdono la connessione AMQP\\n• Tutti bufferizzano in RAM\\n• Al ripristino: burst simultaneo da 10 sensori\\n';\n    } else if (tipo === 'gateway') {\n        corpo += 'Cosa osservare:\\n• I sensori continuano a pubblicare normalmente\\n• I messaggi si ACCUMULANO nella queue durable\\n• Controlla http://localhost:15672 → Queues → iot.temperature\\n• Al ripristino: il gateway drena la queue in burst\\n';\n    } else if (tipo === 'nodered') {\n        corpo += 'Cosa osservare:\\n• Node-RED perde la connessione a InfluxDB\\n• Il grafico smette di aggiornarsi\\n• I dati continuano ad arrivare su InfluxDB\\n';\n    }\n} else {\n    soggetto = '[CHAOS #' + cnt + '] RESTORE — ' + tipo + ' (' + cont + ')';\n    corpo = 'RIPRISTINO CHAOS #' + cnt + '\\n══════════════════════════════\\n';\n    corpo += cont + ' — RICONNESSO\\n\\n';\n    if (tipo === 'sensor_single' || tipo === 'sensor_multi') {\n        corpo += 'Cosa verificare:\\n• Il sensore si riconnette a RabbitMQ\\n• Flush del buffer locale (vedi log [BUFFER])\\n';\n    } else if (tipo === 'rabbitmq') {\n        corpo += 'Cosa verificare:\\n• Burst da tutti i sensori simultaneamente\\n• Il gateway riprende a consumare\\n';\n    } else if (tipo === 'gateway') {\n        corpo += 'Cosa verificare:\\n• Il gateway drena la queue (burst su InfluxDB)\\n• Il grafico si aggiorna con i dati mancanti\\n';\n    }\n}\nmsg.topic   = soggetto;\nmsg.payload = corpo;\nmsg.to      = 'studente@lab.local';\nmsg.from    = 'chaos-amqp@lab.local';\nreturn msg;\n","outputs":1,"noerr":0,"x":400,"y":80,"wires":[["amqp-email-chaos","amqp-debug-chaos","amqp-http-resp-chaos"]]},{"id":"amqp-email-chaos","type":"e-mail","z":"tab-amqp-chaos","server":"mailhog","port":"1025","authtype":"NONE","tls":false,"name":"Mailhog","dname":"Email Chaos","x":620,"y":60,"wires":[]},{"id":"amqp-debug-chaos","type":"debug","z":"tab-amqp-chaos","name":"Debug","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","x":620,"y":100,"wires":[]},{"id":"amqp-http-resp-chaos","type":"http response","z":"tab-amqp-chaos","name":"200 OK","statusCode":"200","headers":{},"x":620,"y":140,"wires":[]}]